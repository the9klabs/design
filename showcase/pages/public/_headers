# Cloudflare Pages response headers for the @9klabs/design showcase.
#
# Syntax: a URL pattern on its own line, then indented `Name: value` lines.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# The Link headers below follow RFC 8288 and use only relation types from the
# IANA Link Relations registry, so an agent can resolve what they mean instead
# of guessing. Related relations share one comma-separated Link header, which
# RFC 8288 section 3 permits and which sidesteps differences in how proxies
# handle a repeated field name.
#
# Deliberately absent: rel="api-catalog" (RFC 9727). This site publishes a
# component library, not an HTTP API, so it has no catalog of API endpoints to
# advertise and a /.well-known/api-catalog here would describe nothing.
#
# Also absent: a link to /sitemap.xml. There is no registered "sitemap" relation
# in the IANA registry, and robots.txt already advertises it through the channel
# every crawler honours. Reaching for rel="alternate" instead would be a lie:
# the sitemap is not an alternate representation of the homepage.
#
# The canonical URL is pinned to SITE_URL in showcase/site/config.ts;
# tests/showcaseLinkHeaders.test.ts fails if the two drift apart.

/
  Link: <https://design.the9klabs.com/>; rel="canonical", </components.json>; rel="service-desc"; type="application/json", </llms.txt>; rel="describedby"; type="text/plain"

/index.html
  Link: <https://design.the9klabs.com/>; rel="canonical", </components.json>; rel="service-desc"; type="application/json", </llms.txt>; rel="describedby"; type="text/plain"

# The machine-readable mirrors point back at the page a human should read.
/components.json
  Link: </>; rel="service-doc"; type="text/html"

/llms.txt
  Link: </>; rel="service-doc"; type="text/html"

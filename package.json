{
  "name": "@9klabs/design",
  "version": "0.1.0",
  "packageManager": "pnpm@11.10.0",
  "description": "Reusable Vue 3 components and tokens from the Ismail9k design system.",
  "type": "module",
  "files": [
    "dist",
    "src/styles/font-faces.css",
    "src/assets/fonts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css",
    "./font-faces.css": "./src/styles/font-faces.css"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit --project tsconfig.storybook.json && vue-tsc --noEmit --project tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "showcase": "vitepress dev showcase",
    "build-storybook": "storybook build",
    "build:showcase": "vitepress build showcase",
    "check": "pnpm test && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run build-storybook && pnpm run build:showcase",
    "prepare": "pnpm run build"
  },
  "keywords": [
    "vue",
    "design-system",
    "ismail9k"
  ],
  "author": "Abdelrahman Ismail",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/vue3-vite": "^10.5.9",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "latest",
    "@vue/compiler-core": "^3.5.44",
    "@vue/compiler-dom": "^3.5.44",
    "@vue/server-renderer": "^3.5.44",
    "@vue/test-utils": "^2.4.11",
    "dom-accessibility-api": "^0.6.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^29.1.1",
    "postcss": "8.5.26",
    "prettier": "^3.9.6",
    "storybook": "^10.5.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vite": "latest",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "vue": "latest",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "latest"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "normalize.css": "8.0.1"
  }
}

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "tests/**/*.ts",
    "showcase/**/*.ts",
    "showcase/**/*.vue",
    "showcase/.vitepress/**/*.ts",
    "showcase/.vitepress/**/*.vue"
  ],
  "exclude": ["showcase/.vitepress/cache", "showcase/.vitepress/.temp"]
}
